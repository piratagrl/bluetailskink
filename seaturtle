// 3. STATE CONTROL TRACKERS
// =========================================================================
var currentKey = "location";
var savedAnswers = {}; // Stores selections securely by key (e.g., {"location": "Fox Books"})

// =========================================================================
// 4. DICTIONARY RENDERING ENGINE
// =========================================================================
function renderQuestion() {
  var currentQ = questionFlow[currentKey];
  document.getElementById("questionTitle").innerText = currentQ.text;
  var wrapper = document.getElementById("optionsWrapper");
  wrapper.innerHTML = ""; // Reset structural framework layout
  
  document.getElementById("nextButton").disabled = true;
  document.getElementById("readerPane").classList.remove("active");
  document.getElementById("outputText").innerHTML = "Complete the input above to read the output...";
  
  if (currentQ.next === null) {
    document.getElementById("nextButton").innerText = "Finalize Process";
  } else {
    document.getElementById("nextButton").innerText = "Next Question";
  }

  // A. Render String Input Layout
  if (currentQ.type === "string") {
    var inputElement = document.createElement("input");
    inputElement.type = "text";
    inputElement.placeholder = currentQ.placeholder;
    inputElement.style.width = "85%";
    inputElement.style.padding = "12px";
    inputElement.style.backgroundColor = "#1a1d20";
    inputElement.style.color = "#00E5A3";
    inputElement.style.border = "1px solid #495057";
    inputElement.style.borderRadius = "6px";
    inputElement.style.fontSize = "1rem";

    inputElement.onkeydown = function(event) {
      if (event.key === "Enter" || event.keyCode === 13) {
        var nextBtn = document.getElementById("nextButton");
        if (!nextBtn.disabled) { event.preventDefault(); nextBtn.click(); }
      }
    };

    // 🌟 REUSABLE SENTENCE BUILDER
    function updateLiveStringOutput(value) {
      var prefix = "";
      
      if (currentKey === "result") {
        prefix = "This caused the ADV to ";
      } else if (currentKey === "action") {
        var prevAns = savedAnswers["trigger"] || "";
        var lowerAns = prevAns.toLowerCase();
        if (lowerAns.includes("ped") || lowerAns.includes("vru") || lowerAns.includes("oru") || lowerAns.includes("leo") || lowerAns.includes("adv") || lowerAns.includes("object")) {
          prefix = "The incident was initiated when " + prevAns + " ";
        }
      } else if (currentKey === "es_why") {
        prefix = "Emergency services were contacted due to ";
      }

      if (value.length > 0) {
        document.getElementById("readerPane").classList.add("active");
        var liveOutput = 'Narrative: <span style="color: #00E5A3;">"' + prefix + value + '"</span>';
        evaluateAnswer(liveOutput, value);
      } else {
        // Keep the next button locked until they type content
        document.getElementById("nextButton").disabled = true;
        
        if (prefix) {
          // 🌟 FORCE ACTIVE LOOK: Keep the pane lit and text bright green before typing!
          document.getElementById("readerPane").classList.add("active");
          document.getElementById("outputText").innerHTML = 'Narrative: <span style="color: #00E5A3;">"' + prefix + '..."</span>';
        } else {
          document.getElementById("readerPane").classList.remove("active");
          document.getElementById("outputText").innerHTML = "Complete the input above to read the output...";
        }
      }
    }

    // Trigger on live key entries
       inputElement.oninput = function() {
      // 🌟 MAXIMUM CEILING CAP: Limits the entry field to a maximum of 8 characters!
      if (currentKey === "license_plate" && this.value.length > 8) {
        this.value = this.value.slice(0, 8);
      }
      updateLiveStringOutput(this.value.trim());
    };

    
    wrapper.appendChild(inputElement);
    inputElement.focus();
    
    // 🌟 EXECUTE IMMEDIATELY ON LOAD: Populates the live viewer instantly!
    updateLiveStringOutput("");
  } 
  // 🌟 NEW DEDICATED TEXT DROPDOWN ENGINE LAYER
  else if (currentQ.type === "select_menu") {
    var selectElement = document.createElement("select");
    selectElement.style.width = "45%";
    selectElement.style.padding = "12px";
    selectElement.style.backgroundColor = "#1a1d20";
    selectElement.style.color = "#00E5A3";
    selectElement.style.border = "1px solid #495057";
    selectElement.style.borderRadius = "6px";
    selectElement.style.fontSize = "1.2rem";

    currentQ.options.forEach(function(state) {
      var optElement = document.createElement("option");
      optElement.value = state;
      optElement.innerText = state;
      if (currentQ.defaultValue && state === currentQ.defaultValue) {
        optElement.selected = true;
      }
      selectElement.appendChild(optElement);
    });

    function handleDropdownChange(val) {
      var liveOutput = "";
      var rawTextValue = "";
      
      if (val === "N/A") {
        liveOutput = '<span style="color: #6f42c1; font-weight: bold;">"N/A"</span>';
        rawTextValue = ""; // Ghost output
      } else {
        liveOutput = 'LP State: <span style="color: #00E5A3; font-weight: bold;">"' + val + '"</span>';
        rawTextValue = "ORU LP STATE: " + val + ". ";
      }
      evaluateAnswer(liveOutput, rawTextValue);
    }

    selectElement.onchange = function() { handleDropdownChange(this.value); };
    wrapper.appendChild(selectElement);
    selectElement.focus();
    handleDropdownChange(selectElement.value); // Lock in pre-fill instantly
  }

  // B. Render Spinner Input Layout (Handles numbers AND state dropdown menus)
  // 🌟 STANDALONE LAYER 1: Cleanly Renders Text/State Dropdowns (select_menu)
  else if (currentQ.type === "select_menu") {
    var selectElement = document.createElement("select");
    selectElement.style.width = "45%";
    selectElement.style.padding = "12px";
    selectElement.style.backgroundColor = "#1a1d20";
    selectElement.style.color = "#00E5A3";
    selectElement.style.border = "1px solid #495057";
    selectElement.style.borderRadius = "6px";
    selectElement.style.fontSize = "1.2rem";

    currentQ.options.forEach(function(state) {
      var optElement = document.createElement("option");
      optElement.value = state;
      optElement.innerText = state;
      if (currentQ.defaultValue && state === currentQ.defaultValue) {
        optElement.selected = true;
      }
      selectElement.appendChild(optElement);
    });

    function handleDropdownChange(val) {
      var liveOutput = "";
      var rawTextValue = "";
      
      if (val === "N/A") {
        liveOutput = '<span style="color: #6f42c1; font-weight: bold;">"N/A"</span>';
        rawTextValue = ""; // Ghost output disappears from paragraph narrative
      } else {
        liveOutput = 'LP State: <span style="color: #00E5A3; font-weight: bold;">"' + val + '"</span>';
        rawTextValue = "ORU LP STATE: " + val + ". ";
      }
      evaluateAnswer(liveOutput, rawTextValue);
    }

    selectElement.onchange = function() { handleDropdownChange(this.value); };
    wrapper.appendChild(selectElement);
    selectElement.focus();
    handleDropdownChange(selectElement.value); // Lock in pre-fill instantly
  }
  
  // 🌟 STANDALONE LAYER 2: Strictly Renders Numerical Speeds (spinner)
  else if (currentQ.type === "spinner") {
    var inputElement = document.createElement("input");
    inputElement.type = "number";
    inputElement.min = currentQ.min;
    inputElement.max = currentQ.max;
    inputElement.value = currentQ.defaultValue;
    inputElement.style.width = "40%";
    inputElement.style.padding = "12px";
    inputElement.style.backgroundColor = "#1a1d20";
    inputElement.style.color = "#00E5A3";
    inputElement.style.border = "1px solid #495057";
    inputElement.style.borderRadius = "6px";
    inputElement.style.fontSize = "1.5rem";
    inputElement.style.textAlign = "center";

    function handleSpeedChange(val) {
      var speedNum = parseInt(val, 10);
      if (!isNaN(speedNum) && speedNum >= currentQ.min && speedNum <= currentQ.max) {
        var liveOutput = 'Operating speed: <span style="color: #00E5A3;">" ' + speedNum + ' MPH"</span>';
        evaluateAnswer(liveOutput, speedNum);
      } else {
        document.getElementById("nextButton").disabled = true;
        document.getElementById("readerPane").classList.remove("active");
        document.getElementById("outputText").innerHTML = "Please input a valid speed value...";
      }
    }
    inputElement.oninput = function() { handleSpeedChange(this.value); };
    wrapper.appendChild(inputElement);
    inputElement.focus();
    handleSpeedChange(inputElement.value);
  }



  // C. Render Checkbox Input Layout
  else if (currentQ.type === "checkbox") {
    currentQ.options.forEach(function(opt) {
      var labelElement = document.createElement("label");
      labelElement.className = "option-label";
      var checkboxInput = document.createElement("input");
      checkboxInput.type = "checkbox";
      checkboxInput.name = "dynamicCheckbox";
      checkboxInput.value = opt.value;
      
      checkboxInput.onchange = function() {
        var allBoxes = wrapper.querySelectorAll('input[name="dynamicCheckbox"]');
        
        // ABSOLUTE EXCLUSIVE OVERRIDE CHECKER:
        if (this.checked) {
          if (this.value === "N/A") {
            allBoxes.forEach(function(box) { if (box.value !== "N/A") box.checked = false; });
          } else if (this.value === "Made no special requests" || this.value === "No contact") {
            allBoxes.forEach(function(box) { if (box.value !== "Made no special requests" && box.value !== "No contact") box.checked = false; });
          } else {
            allBoxes.forEach(function(box) {
              if (box.value === "N/A" || box.value === "No contact" || box.value === "Made no special requests") box.checked = false;
            });
          }
        }

        // Recalculate checked metrics post clean up
        var checkedBoxes = wrapper.querySelectorAll('input[name="dynamicCheckbox"]:checked');
        var selectedLabels = [];
        checkedBoxes.forEach(function(box) { selectedLabels.push(box.value); });
        
        if (selectedLabels.length > 0) {
          var finalParagraphSnippet = "";
          var liveLabelPrefix = "";
          
          // 🌟 BRANCH A: QUESTION 6 (CONTACT POINTS)
          if (currentKey === "contact_point") {
            liveLabelPrefix = "Contact zones: ";
            if (selectedLabels.includes("No contact")) {
              finalParagraphSnippet = "There was no physical contact to the ADV. ";
            } else {
              if (selectedLabels.length === 1) {
                finalParagraphSnippet = "This resulted in contact to the " + selectedLabels[0] + " region(s). ";
              } else if (selectedLabels.length === 2) {
                finalParagraphSnippet = "This resulted in contact to the " + selectedLabels[0] + " and " + selectedLabels[1] + " region(s). ";
              } else {
                var lastLabel = selectedLabels.pop();
                finalParagraphSnippet = "This resulted in contact to the " + selectedLabels.join(", ") + ", and " + lastLabel + " region(s). ";
                selectedLabels.push(lastLabel);
              }
            }
          } 
          // 🌟 BRANCH B: QUESTION 16 (RIDER REQUESTS)
          else if (currentKey === "requests") {
            liveLabelPrefix = "Rider requests: ";
            if (selectedLabels.includes("N/A")) {
              finalParagraphSnippet = ""; // Ghost output
            } else if (selectedLabels.includes("Made no special requests")) {
              finalParagraphSnippet = "The rider made no special safety requests. ";
            } else {
              var actionSnippets = selectedLabels.map(val => val.toLowerCase());
              if (actionSnippets.length === 1) {
                finalParagraphSnippet = "The rider " + actionSnippets[0] + ". ";
              } else if (actionSnippets.length === 2) {
                finalParagraphSnippet = "The rider " + actionSnippets[0] + " and " + actionSnippets[1] + ". ";
              } else {
                var lastAction = actionSnippets.pop();
                finalParagraphSnippet = "The rider " + actionSnippets.join(", ") + ", and " + lastAction + ". ";
                actionSnippets.push(lastAction);
              }
            }
          }
          // 🌟 BRANCH C: FALLBACK FOR OTHER CHECKBOXES (like TOS violations)
          else {
            liveLabelPrefix = "Selected options: ";
            finalParagraphSnippet = selectedLabels.join(", ") + ". ";
          }
          
          var liveDisplay = finalParagraphSnippet ? liveLabelPrefix + '<span style="color: #00E5A3;">"' + finalParagraphSnippet + '"</span>' : liveLabelPrefix + '<span style="color: #6c757d; font-style: italic;">[No Paragraph Text Generated]</span>';
          evaluateAnswer(liveDisplay, finalParagraphSnippet);
        } else {
          document.getElementById("nextButton").disabled = true;
          document.getElementById("readerPane").classList.remove("active");
          document.getElementById("outputText").innerHTML = "Select at least one option to proceed...";
        }
      };
      
      labelElement.appendChild(checkboxInput);
      labelElement.appendChild(document.createTextNode(" " + opt.label));
      wrapper.appendChild(labelElement);
    });
  }


   // D. Render Standard Radio Input Layout
  else {
    currentQ.options.forEach(function(opt) {
      var labelElement = document.createElement("label");
      labelElement.className = "option-label";
      var radioInput = document.createElement("input");
      radioInput.type = "radio";
      radioInput.name = "dynamicChoice";
      radioInput.value = opt.value;
      
      // 🌟 AUTOMATION: Pre-check the circle immediately if it matches the default!
      if (currentQ.defaultValue && opt.value === currentQ.defaultValue) {
        radioInput.checked = true;
      }

      radioInput.onchange = function() {
        var displayHtml = opt.output || opt.label;
        var rawValueToSave = opt.narrativeStart || opt.raw || opt.label;
        evaluateAnswer(displayHtml, rawValueToSave);
      };
      
      labelElement.appendChild(radioInput);
      labelElement.appendChild(document.createTextNode(" " + opt.label));
      wrapper.appendChild(labelElement);
    });

    // 🌟 AUTOMATION: If a default value exists, instantly fire it into the live output tracker!
    if (currentQ.defaultValue) {
      var defaultOpt = currentQ.options.find(o => o.value === currentQ.defaultValue);
      if (defaultOpt) {
        var displayHtml = defaultOpt.output || defaultOpt.label;
        var rawValueToSave = defaultOpt.narrativeStart || defaultOpt.raw || defaultOpt.label;
        evaluateAnswer(displayHtml, rawValueToSave);
      }
    }
  }
}

function evaluateAnswer(customOutput, rawTextValue) {
  document.getElementById("readerPane").classList.add("active");
  document.getElementById("outputText").innerHTML = customOutput;
  savedAnswers[currentKey] = rawTextValue; // Save response to dictionary key
  document.getElementById("nextButton").disabled = false;
}
// =========================================================================
// 5. NAVIGATION ROUTER (HANDLES AUTOMATIC ROUTING AND BYPASSES)
// =========================================================================
function loadNextQuestion() {
  var currentQ = questionFlow[currentKey];
  var nextKey = currentQ.next; // Grab the normal sequential next step key string

  // UNIVERSAL RADIO OVERRIDE CHECKER:
  if (currentQ.type === "radio") {
    var selectedRadio = document.querySelector('input[name="dynamicChoice"]:checked');
    if (selectedRadio) {
      var chosenOpt = currentQ.options.find(o => o.value === selectedRadio.value);
      if (chosenOpt && chosenOpt.nextOverride) {
        nextKey = chosenOpt.nextOverride;
      }
    }
  }

  // SPECIAL BYPASS: Question 13 -> Question 15 Interception
  if (currentKey === "triggers_action") {
    var selectedRadio = document.querySelector('input[name="dynamicChoice"]:checked');
    if (selectedRadio) {
      var chosenOpt = currentQ.options.find(o => o.value === selectedRadio.value);
      if (chosenOpt && chosenOpt.skipOruInjury) {
        savedAnswers["injury_ORU"] = ""; 
        if (nextKey === "injury_rider") {
          questionFlow["injury_rider"].next = "requests"; 
        } else {
          nextKey = "requests";
        }
      } else {
        questionFlow["injury_rider"].next = "injury_ORU";
      }
    }
  }
  if (currentKey === "injury_rider" && savedAnswers["injury_ORU"] === "") {
    nextKey = "requests";
  }

  // 🌟 NEW DYNAMIC AUTOMATIC BYPASS: Question 23 (State Selection) -> Question 24
  if (currentKey === "license_state") {
    var selectedState = savedAnswers["license_state"] || "";
    // If the agent leaves it on N/A or it wasn't captured, bypass the license plate text box entirely!
    if (selectedState === "" || selectedState === "N/A") {
      savedAnswers["license_plate"] = ""; // Quietly log it blank in the background for your metadata grid
      nextKey = "did_you_speak";          // 🚀 Jump straight past 23a to the speaker checkpoint!
    }
  }

  // If there's another step to load, advance the active key pointer and update the UI
  if (nextKey && questionFlow[nextKey]) {
    currentKey = nextKey;
    renderQuestion();
  } else {
    // Reached the terminal node of the dictionary! Open the final copy terminal modal box
    finalizeReportFromDictionary();
  }
}






// =========================================================================
// 6. TERMINAL REPORT COMPILER (BUILDS PARAGRAPH AND CHECKLIST SPREADSHEET VIEWS)
// =========================================================================
function finalizeReportFromDictionary() {
  // Extract all text responses by variable key name
  var locationVal   = savedAnswers["location"] || "N/A";
  var riderStatus   = savedAnswers["rider_status"] || "N/A";
  var tripStatus    = savedAnswers["trip_status"] || "N/A";
  var speedText     = savedAnswers["speed"] !== undefined ? savedAnswers["speed"] + " MPH" : "0 MPH";
  var laneText      = savedAnswers["lane_position"] || "N/A";
  var directionText = savedAnswers["direction"] || "N/A";
  var triggerText   = savedAnswers["trigger"] || "N/A";
  var actionText    = savedAnswers["action"] || "";
  var resultText    = savedAnswers["result"] || "";
  var contactText   = savedAnswers["contact_point"] || "No contact";
  var postStatus    = savedAnswers["post_incident_status"] || "N/A";
  var leoText       = savedAnswers["LEO_on_scene"] || "N/A";
  var emsCall       = savedAnswers["es_call"] || "N/A";
  var emsWhy        = savedAnswers["es_why"] || "N/A";
  
  // 1. Build the natural sentence narrative block
  var paragraph = "Description: The event took place at " + locationVal + ". Vehicle status was marked as " + riderStatus + " " + tripStatus + ". Prior to the event, the ADV was traveling at " + speedText + " in the " + laneText + " lane, " + directionText + ". The incident initiated when " + triggerText + " " + actionText + ", which caused the ADV to " + resultText + ". " + contactText + ". Post-incident status: " + postStatus + ".";
  if (emsCall === "911 was called") {
    paragraph += " Emergency services were contacted due to " + emsWhy + ".";
  } else {
    paragraph += " Emergency services were not called.";
  }

  // 2. Build the structural checklist grid mimicking your tail section spreadsheet layout
  var spreadsheetTail = "\n\n" +
    "----------------------------------------\n" +
    "REPORT METADATA TEMPLATE LOG:\n" +
    "----------------------------------------\n" +
    "0 Location: " + locationVal + "\n" +
    "1 Rider Present: " + (riderStatus.toLowerCase().includes("no riders") ? "No" : "Yes") + "\n" +
    "2 Trip Phase: " + tripStatus + "\n" +
    "3a Speed: " + speedText + "\n" +
    "3b Lane Position: " + laneText + "\n" +
    "3c Direction: " + directionText + "\n" +
    "4a External Trigger: " + triggerText + "\n" +
    "6 Physical Contact Point: " + contactText + "\n" +
    "7 Post-Incident ADV Status: " + postStatus + "\n" +
    "8 Spoke with LEO on scene: " + leoText + "\n" +
    "9 Was emergency services called: " + (emsCall.includes("not called") ? "No" : "Yes") + "\n" +
    "9a If Yes: State the reason for the call: " + (emsCall.includes("not called") ? "N/A" : emsWhy) + "\n" +
    "22 Was AZ DPS/ Sky harbor called: " + (savedAnswers["dpsCall"] || "No") + "\n" +
    "23 ORU license plate: " + (savedAnswers["license_plate"] || "Unknown") + "\n" +
    "23a ORU LP STATE: " + (savedAnswers["license_state"] || "N/A") + "\n" +
    "24a Call link: " + (savedAnswers["call_link"] || "N/A") + "\n" +
    "24b Case notes link: " + (savedAnswers["case_link"] || "N/A") + "\n" +
    "24c TOS Violations Checked: " + (savedAnswers["tos_violations"] || "None");

  // Output the clean fused result directly to your modal popup system clipboard block
  document.getElementById("finalSummaryText").value = paragraph + spreadsheetTail;
  document.getElementById("copyModal").style.display = "flex";
}


      function closeModal() {
        document.getElementById("copyModal").style.display = "none";
      }

      function copyToClipboard() {
        var copyText = document.getElementById("finalSummaryText");
        copyText.select();
        copyText.setSelectionRange(0, 99999); 
        navigator.clipboard.writeText(copyText.value);
        
        var btn = document.getElementById("clipboardBtn");
        btn.innerText = "COPIED SUCCESSFULLY!";
        btn.style.backgroundColor = "#00E5A3";
        btn.style.color = "#1a1d20";
        
        setTimeout(function() {
          btn.innerText = "COPY DATA TO CLIPBOARD";
          btn.style.backgroundColor = "#343a40";
          btn.style.color = "#ffffff";
        }, 2000);
      }

      // Bootstrap start
      renderQuestion();
    </script>



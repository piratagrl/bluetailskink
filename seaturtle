<!DOCTYPE html>
<html>
  <head>
    <base target="_top">
    <style>
      /* Layout & Background Setup */
      html, body {
        background-color: #212529 !important; 
        color: #ffffff;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        margin: 0;
        padding: 20px;
        height: 100vh;
        box-sizing: border-box;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 20px;
      }

      /* Boxed-in Question Container (Top Panel) */
      .question-box {
        width: 100%;
        max-width: 500px;
        background-color: #2b3035;
        border: 2px solid #00E5A3; 
        border-radius: 8px;
        padding: 20px;
        text-align: center;
        box-shadow: 0 4px 15px rgba(0,0,0,0.4);
      }

      .question-text {
        font-size: 1.2rem;
        font-weight: bold;
        margin-bottom: 15px;
      }

      /* Radio Button Choice Wrapper - Now stacked vertically */
      .options-container {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 10px;
        margin-bottom: 20px;
        width: 100%;
      }

      /* Clean, wide option cards that don't squish your sentences */
      .option-label {
        background-color: #343a40;
        padding: 14px 20px;
        border-radius: 6px;
        cursor: pointer;
        border: 1px solid #495057;
        transition: all 0.2s ease;
        display: flex;
        align-items: center;
        gap: 12px;
        width: 85%; /* Perfectly matches your text input box width */
        box-sizing: border-box;
        text-align: left;
      }

      .option-label:hover {
        border-color: #00E5A3;
        background-color: #3d444b;
      }

      /* Mint/Turquoise Button Styling */
      .next-btn {
        background-color: #00E5A3;
        color: #1a1d20;
        border: none;
        padding: 10px 24px;
        font-size: 1rem;
        font-weight: bold;
        border-radius: 6px;
        cursor: pointer;
        box-shadow: 0 4px 10px rgba(0, 229, 163, 0.2);
        transition: all 0.2s ease;
      }

      .next-btn:hover {
        background-color: #0df2a7;
        box-shadow: 0 4px 15px rgba(0, 229, 163, 0.4);
      }
      
      .next-btn:disabled {
        background-color: #495057;
        color: #868e96;
        cursor: not-allowed;
        box-shadow: none;
      }

      /* Output Reader Pane (Bottom Panel) */
      .reader-pane {
        width: 100%;
        max-width: 500px;
        background-color: #1a1d20;
        border-radius: 8px;
        padding: 20px;
        min-height: 80px;
        box-sizing: border-box;
        border-left: 4px solid #6c757d; 
        transition: border-color 0.3s ease;
      }

      .reader-pane.active {
        border-left-color: #00E5A3; 
      }

      .pane-label {
        font-size: 0.8rem;
        color: #6c757d;
        text-transform: uppercase;
        letter-spacing: 1px;
        margin-bottom: 8px;
      }

      #outputText {
        font-size: 1.1rem;
        color: #a0a5aa;
        font-style: italic;
      }

      /* MODAL POPUP SYSTEM OVERLAY */
      .modal-overlay {
        display: none; 
        position: fixed;
        top: 0; left: 0; width: 100%; height: 100%;
        background-color: rgba(0, 0, 0, 0.75);
        justify-content: center;
        align-items: center;
        z-index: 1000;
      }

      .modal-box {
        background-color: #2b3035;
        border-radius: 12px;
        width: 90%;
        max-width: 480px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.6);
        border: 1px solid #495057;
        overflow: hidden;
      }

      .modal-header {
        padding: 15px 20px;
        background-color: #212529;
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 1px solid #495057;
      }

      .modal-title {
        font-size: 1.1rem;
        font-weight: bold;
        color: #f8f9fa;
      }

      .close-btn {
        background: none;
        border: none;
        color: #a0a5aa;
        font-size: 1.5rem;
        cursor: pointer;
      }

      .close-btn:hover {
        color: #ffffff;
      }

      .modal-body {
        padding: 20px;
      }

      .instruction-text {
        font-size: 0.9rem;
        color: #a0a5aa;
        margin-bottom: 12px;
      }

      .copy-textarea {
        width: 100%;
        height: 120px;
        background-color: #1a1d20;
        color: #00E5A3; 
        border: 1px solid #495057;
        border-radius: 6px;
        padding: 12px;
        box-sizing: border-box;
        font-family: 'Courier New', Courier, monospace;
        font-size: 0.95rem;
        resize: none;
        margin-bottom: 15px;
      }

      .copy-action-btn {
        width: 100%;
        background-color: #343a40;
        color: #ffffff;
        border: 1px solid #00E5A3;
        padding: 12px;
        font-size: 1rem;
        font-weight: bold;
        border-radius: 6px;
        cursor: pointer;
        transition: all 0.2s ease;
      }

      .copy-action-btn:hover {
        background-color: #00E5A3;
        color: #1a1d20;
      }
    </style>
  </head>
  <body>

    <!-- TOP PANEL: Boxed In Question -->
    <div class="question-box">
      <div class="question-text" id="questionTitle"><!-- Set by JavaScript --></div>
      
      <div class="options-container" id="optionsWrapper">
        <!-- Generated Dynamically -->
      </div>

      <div>
        <button class="next-btn" id="nextButton" onclick="loadNextQuestion()" disabled>Finalize Process</button>
      </div>
    </div>

    <!-- BOTTOM PANEL: Output Reader Pane -->
    <div class="reader-pane" id="readerPane">
      <div class="pane-label">Live Output Reader</div>
      <div id="outputText">Select an option above to read the output...</div>
    </div>

    <!-- THE FINALIZE POPUP MODAL WINDOW -->
    <div class="modal-overlay" id="copyModal">
      <div class="modal-box">
        <div class="modal-header">
          <div class="modal-title">Secure Copy (Protected Logic)</div>
          <button class="close-btn" onclick="closeModal()">&times;</button>
        </div>
        <div class="modal-box-body modal-body">
          <div class="instruction-text">Press the button below to copy data directly to clipboard:</div>
          <textarea class="copy-textarea" id="finalSummaryText" readonly></textarea>
          <button class="copy-action-btn" id="clipboardBtn" onclick="copyToClipboard()">COPY DATA TO CLIPBOARD</button>
        </div>
      </div>
    </div>

    <!-- QUESTIONS ENGINE & ROUTER SCRIPT -->
        <!-- QUESTIONS ENGINE & ROUTER SCRIPT -->
    <script>
      // =========================================================================
// CLASS ENGINE BLUEPRINTS 
// =========================================================================
class Question {
  constructor({ text, next, templateLabel = "" }) {
    this.text = text;
    this.next = next;
    this.templateLabel = templateLabel;
  }
}

class StringQuestion extends Question {
  constructor(config) {
    super(config);
    this.type = "string";
    this.placeholder = config.placeholder || "";
  }
}

class SpinnerQuestion extends Question {
  constructor(config) {
    super(config);
    this.type = "spinner";
    this.min = config.min || 0;
    this.max = config.max || 100;
    this.defaultValue = config.defaultValue || 0;
  }
}

// 🌟 NEW DEDICATED TEXT/LETTER DROPDOWN DROPDOWN CLASS
class SelectQuestion extends Question {
  constructor(config) {
    super(config);
    this.type = "select_menu";
    this.options = config.options || []; // Expects standard array of text strings e.g. ["N/A", "AZ"]
  }
}

class RadioQuestion extends Question {
  constructor(config) {
    super(config);
    this.type = "radio";
    this.options = config.options || [];
    // 🌟 NEW: Tracks which option key should be checked instantly on load!
    this.defaultValue = config.defaultValue || null; 
  }
}


class CheckboxQuestion extends Question {
  constructor(config) {
    super(config);
    this.type = "checkbox";
    this.options = config.options || [];
  }
}

      // 1. Data Store containing your sequential testing blocks
      // Added type: "string" for the first entry to handle open input fields
      // =========================================================================
// THE MASTER DICTIONARY OBJECT (OOP INSTANCES MATCHING SPREADSHEET EXACTLY)
// =========================================================================
var questionFlow = {
  // 0. Location
  "location": new StringQuestion({
    text: "Location:",
    placeholder: "e.g., 1500 Young St, Dallas, TX 75201",
    next: "rider_status",
    templateLabel: "Location:"
  }),

  // ORANGE / CONTEXT
  "rider_status": new RadioQuestion({
    text: "1. Was there a rider present in the vehicle?",
    next: "trip_status",
    templateLabel: "Rider present in vehicle:",
    options: [
      { label: "No riders", value: "no_riders", output: '<span style="color: #e63946;">"There were no riders present when the event occurred"</span>', raw: "There were no riders present when the event occurred" },
      { label: "A rider", value: "one_rider", output: '<span style="color: #00E5A3;">"There was a rider present when the event occurred"</span>', raw: "There was a rider present when the event occurred" },
      { label: "Multiple riders", value: "riders_present", output: '<span style="color: #00E5A3;">"There were riders present when the event occurred"</span>', raw: "There were riders present when the event occurred" },
      { label: "Uber rider", value: "uber_rider", output: '<span style="color: #2b9348;">"There was an UBER rider present when the event occurred"</span>', raw: "There was an UBER rider present when the event occurred" },
      { label: "Driver", value: "driver_present", output: '<span style="color: #ffc107;">"There was a driver present when the event occurred"</span>', raw: "There was a driver present when the event occurred" }
    ]
  }),

  "trip_status": new RadioQuestion({
    text: "2. When in the trip did this incident occur?",
    next: "speed",
    templateLabel: "When in trip incident occurred:",
    options: [
      { label: "At pickup", value: "pickup", output: '<span style="color: #007bff;">"while the ADV was at pickup"</span>', raw: ", while the ADV was at pickup" },
      { label: "At dropoff", value: "dropoff", output: '<span style="color: #fd7e14;">"while the ADV was at dropoff"</span>', raw: ", while the ADV was at dropoff" },
      { label: "On the rider's trip", value: "rider_trip", output: '<span style="color: #00E5A3;">"while on the rider\'s trip"</span>', raw: ", while on the rider's trip" },
      { label: "Driving freely waiting for a mission", value: "driving_freely", output: '<span style="color: #e63946;">"while the ADV was driving freely waiting for a mission"</span>', raw: ", while the ADV was driving freely waiting for a mission" },
      { label: "On driver's route", value: "driver_route", output: '<span style="color: #ffc107;">"while on driver\'s route"</span>', raw: ", while on driver's route" }
    ]
  }),

  "speed": new SpinnerQuestion({
    text: "3a. What was the baseline status of the ADV immediately before the event? (Speed)",
    min: 0, max: 75, defaultValue: 0,
    next: "lane_position",
    templateLabel: "Baseline Speed:"
  }),

  "lane_position": new RadioQuestion({
    text: "3b. What was the baseline status of the ADV immediately before the event? (Lane Position)",
    next: "direction",
    templateLabel: "Baseline Lane Position:",
    options: [
      { label: "Parked on curb position", value: "parked_curb", output: '<span style="color: #a0a5aa;">"parked on curb position"</span>', raw: ", parked on curb position" },
      { label: "Left lane", value: "left_lane", output: '<span style="color: #a0a5aa;">"in the left lane"</span>', raw: ", in the left lane" },
      { label: "Middle lanes", value: "middle_lanes", output: '<span style="color: #a0a5aa;">"in the middle lanes"</span>', raw: ", in the middle lanes" },
      { label: "Right lane", value: "right_lane", output: '<span style="color: #a0a5aa;">"in the right lane"</span>', raw: ", in the right lane" },
      { label: "Intersection", value: "intersection", output: '<span style="color: #e63946; font-weight: bold;">\"inside an intersection\"</span>', raw: ", inside an intersection" },
      { label: "Parking lot", value: "parking_lot", output: '<span style="color: #a0a5aa;">\"inside a parking lot\"</span>', raw: ", inside a parking lot" }
    ]
  }),

  "direction": new RadioQuestion({
    text: "3c. What was the baseline status of the ADV immediately before the event? (Direction)",
    next: "trigger",
    templateLabel: "Baseline Direction:",
    options: [
      { label: "Moving straight", value: "moving_straight", output: '<span style="color: #a0a5aa;">"moving straight"</span>', raw: ", moving straight" },
      { label: "Moving backwards", value: "moving_backwards", output: '<span style="color: #a0a5aa;">"moving backwards"</span>', raw: ", moving backwards" },
      { label: "Turning right", value: "turning_right", output: '<span style="color: #a0a5aa;">"turning right"</span>', raw: ", turning right" },
      { label: "Merging right", value: "merging_right", output: '<span style="color: #a0a5aa;">"merging right"</span>', raw: ", merging right" },
      { label: "Turning left", value: "turning_left", output: '<span style="color: #a0a5aa;">"turning left"</span>', raw: ", turning left" },
      { label: "Merging left", value: "merging_left", output: '<span style="color: #a0a5aa;">"merging left"</span>', raw: ", merging left" }
    ]
  }),

  "trigger": new RadioQuestion({
    text: "4a. What was the external trigger or third-party behavior that caused the anomaly? (Who)",
    next: "action",
    templateLabel: "External Trigger / Who:",
    options: [
      { label: "Ped", value: "ped", output: '<span style="color: #00E5A3;">"A Ped"</span>', raw: "a Ped", narrativeStart: "a Ped" },
      { label: "More than one Ped", value: "multiple_peds", output: '<span style="color: #00E5A3;">"Multiple Peds"</span>', raw: "Multiple Peds", narrativeStart: "Multiple Peds" },
      { label: "ORU", value: "oru", output: '<span style="color: #a0a5aa;">"An ORU"</span>', raw: "an ORU", narrativeStart: "an ORU" },
      { label: "VRU", value: "vru", output: '<span style="color: #a0a5aa;">"A VRU"</span>', raw: "a VRU", narrativeStart: "a VRU" },
      { label: "LEO/FR", value: "leo_fr", output: '<span style="color: #a0a5aa;">"LEO/FR"</span>', raw: "LEO/FR", narrativeStart: "LEO/FR" },
      { label: "This ADV", value: "this_adv", output: '<span style="color: #ffc107;">"The ADV"</span>', raw: "this ADV", narrativeStart: "this ADV" },
      { label: "Other ADV", value: "other_adv", output: '<span style="color: #a0a5aa;">"Another ADV"</span>', raw: "another ADV", narrativeStart: "another ADV" },
      { label: "An object", value: "object", output: '<span style="color: #fd7e14;">"An object"</span>', raw: "an object", narrativeStart: "an object" }
    ]
  }),

  "action": new StringQuestion({
    text: "4b. What did they do?",
    placeholder: "e.g., stepped off the curb directly into the path...",
    next: "result",
    templateLabel: "What trigger did:"
  }),

  "result": new StringQuestion({
    text: "5. This caused the ADV to...",
    placeholder: "e.g., hard brake and come to a complete stop...",
    next: "contact_point",
    templateLabel: "ADV Reaction:"
  }),

  "contact_point": new CheckboxQuestion({
    text: "6. What was the immediate physical contact point?",
    next: "post_incident_status",
    templateLabel: "Immediate physical contact point:",
    options: [
      { label: "Back", value: "Back" },
      { label: "Front", value: "Front" },
      { label: "Right", value: "Right" },
      { label: "Left", value: "Left" },
      { label: "Undercarriage/bottom", value: "Undercarriage/bottom" },
      { label: "Top", value: "Top" },
      { label: "Window", value: "Window" },
      { label: "No contact", value: "No contact" }
    ]
  }),

  "post_incident_status": new RadioQuestion({
    text: "7. What was the post-incident status of the ADV?",
    next: "LEO_on_scene",
    templateLabel: "Post-incident status of ADV:",
    options: [
      { label: "WRA was dispatched and Tow was required", value: "wra_and_tow", output: '<span style="color: #e63946; font-weight: bold;">"WRA was dispatched and Tow was required"</span>', raw: "WRA was dispatched and Tow was required" },
      { label: "WRA was dispatched", value: "wra_dispatched", output: '<span style="color: #ffc107; font-weight: bold;">"WRA was dispatched"</span>', raw: "WRA was dispatched" },
      { label: "Tow was dispatched", value: "tow_dispatched", output: '<span style="color: #fd7e14; font-weight: bold;">"Tow was dispatched"</span>', raw: "Tow was dispatched" },
      { label: "ADV returned to normal activity", value: "normal_activity", output: '<span style="color: #00E5A3; font-weight: bold;">"ADV returned to normal activity"</span>', raw: "ADV returned to normal activity" }
    ]
  }),

  // GREEN / AGENT
  "LEO_on_scene": new RadioQuestion({
    text: "8. Did an agent speak with Law Enforcement Officers (LEO) on the scene?",
    next: "es_call",
    templateLabel: "Agent spoke with LEO on scene:",
    options: [
      { label: "Spoke with LEO on scene", value: "spoke_leo", output: '<span style="color: #00E5A3; font-weight: bold;">"Spoke with LEO on scene."</span>', raw: "Spoke with LEO on scene. " },
      { label: "LEO Present on scene but no contact made", value: "leo_no_contact", output: '<span style="color: #fd7e14; font-weight: bold;">"LEO Present on scene but no contact made."</span>', raw: "LEO Present on scene but no contact made. " },
      { label: "No LEO presence or contact on scene", value: "no_leo", output: '<span style="color: #e63946; font-weight: bold;">"No LEO presence or contact on scene."</span>', raw: "" }
    ]
  }),
 "es_call": new RadioQuestion({
    text: "9. Was a 911 call initiated?",
    templateLabel: "Was a 911 call initiated:",
    next: "maneuver",
    options: [
      { label: "911 was called", value: "yes", output: '<span style="color: #00E5A3; font-weight: bold;">"Emergency services were contacted."</span>', raw: "", nextOverride: "es_why" },
      { label: "911 was not called", value: "no", output: '<span style="color: #e63946; font-weight: bold;">"Emergency services were not called."</span>', raw: "Emergency services were not called. " }
    ]
  }),
  "es_why": new StringQuestion({
    text: "9a. Why was 911 called?",
    placeholder: "e.g., third-party requested medical assistance...",
    next: "maneuver",
    templateLabel: "Reason 911 called:"
  }),
  "maneuver": new RadioQuestion({
    text: "10. Did ERT suggest a maneuver to the ADV?",
    next: "hold",
    templateLabel: "ERT suggested maneuver:",
    options: [
      { label: "Yes", value: "yes", output: '<span style="color: #00E5A3; font-weight: bold;">"A manual maneuver was suggested to the ADV."</span>', raw: "A manual maneuver was suggested to the ADV. " },
      { label: "No", value: "no", output: '<span style="color: #e63946; font-weight: bold;">"No manual maneuver was suggested to the ADV."</span>', raw: "" }
    ]
  }),
  "hold": new RadioQuestion({
    text: "11. Was a remote or safety hold placed on the ADV following the incident?",
    next: "insurance",
    templateLabel: "Remote/safety hold placed:",
    options: [
      { label: "Yes", value: "yes", output: '<span style="color: #00E5A3; font-weight: bold;">"A hold was placed on the ADV."</span>', raw: "A hold was placed on the ADV. " },
      { label: "No", value: "no", output: '<span style="color: #e63946; font-weight: bold;">"No hold was placed on the ADV."</span>', raw: "" }
    ]
  }),
  "insurance": new RadioQuestion({
    text: "12. Did ERT exchange insurance information with the Other Road User (ORU)?",
    next: "triggers_action",
    templateLabel: "Insurance information exchanged:",
    options: [
      { 
        label: "Verified Exchanged", 
        value: "verified", 
        output: '<span style="color: #00E5A3; font-weight: bold;">"Insurance information was verified exchanged with the ORU."</span>', 
        raw: "Insurance information was verified exchanged with the ORU. " 
      },
      { 
        label: "Alert Played (Unverified)", 
        value: "unverified_alert", 
        output: '<span style="color: #ffc107; font-weight: bold;">"Played insurance exchange alert but cannot verify if information was exchanged with ORU."</span>', 
        raw: "Played insurance exchange alert but cannot verify if information was exchanged with ORU. " 
      },
      { 
        label: "Not Exchanged", 
        value: "not_exchanged", 
        output: '<span style="color: #e63946; font-weight: bold;">"No insurance information was exchanged with the ORU."</span>', 
        raw: "No insurance information was exchanged with the ORU. " 
      },
      { 
        label: "N/A", 
        value: "na", 
        output: '<span style="color: #6f42c1; font-weight: bold;">"N/A"</span>', 
        raw: "" // Left blank so N/A drops out of the narrative paragraph completely!
      }
    ]
  }),
  "triggers_action": new RadioQuestion({
    text: "13. What did the ORU or VRU do immediately following the interaction?",
    next: "injury_rider",
    templateLabel: "ORU/VRU post-incident action:",
    options: [
      { 
        label: "Stayed on scene", 
        value: "stayed", 
        output: '<span style="color: #2b9348; font-weight: bold;">"The involved party stayed on scene"</span>', 
        raw: "The involved party stayed on scene. " 
      },
      { 
        label: "Left immediately", 
        value: "left_immediately", 
        output: '<span style="color: #007bff; font-weight: bold;">"The involved party left the scene immediately"</span>', 
        raw: "The involved party left the scene immediately. " 
      },
      { 
        label: "Waited then left", 
        value: "waited_left", 
        output: '<span style="color: #17a2b8; font-weight: bold;">"The involved party waited for a little while then left"</span>', 
        raw: "The involved party waited for a little while then left. " 
      },
      { 
        label: "Drove off without stopping", 
        value: "drove_off", 
        output: '<span style="color: #6f42c1; font-weight: bold;">"The involved party drove off without stopping at all"</span>', 
        raw: "The involved party drove off without stopping at all. " 
      },
      { 
        label: "No involved party", 
        value: "no_party", 
        output: '<span style="color: #b07d62; font-weight: bold;">"There was no involved party"</span>', 
        raw: "",
        skipOruInjury: true // 🌟 Tells the engine to automatically handle and skip question 15!
      }

    ]
  }),

  // PINK / RIDER
  "injury_rider": new RadioQuestion({
    text: "14. What was the injury status of the rider?",
    next: "injury_ORU",
    templateLabel: "Injury status of rider:",
    options: [
      { 
        label: "No rider present", 
        value: "no_rider_present", 
        output: '<span style="color: #2b9348; font-weight: bold;">"No rider present"</span>', 
        raw: "No rider present. " 
      },
      { 
        label: "No injuries", 
        value: "no_injuries", 
        output: '<span style="color: #00E5A3; font-weight: bold;">"No rider injuries reported"</span>', 
        raw: "No rider injuries reported. " 
      },
      { 
        label: "Minor injuries", 
        value: "minor", 
        output: '<span style="color: #fd7e14; font-weight: bold;">"Minor rider injuries reported"</span>', 
        raw: "Minor rider injuries reported. " 
      },
      { 
        label: "Non-incapacitating", 
        value: "non_incapacitating", 
        output: '<span style="color: #6f42c1; font-weight: bold;">"Non-incapacitating rider injuries reported"</span>', 
        raw: "Non-incapacitating rider injuries reported. " 
      },
      { 
        label: "Incapacitating", 
        value: "incapacitating", 
        output: '<span style="color: #ff8787; font-weight: bold;">"Incapacitating rider injuries reported"</span>', 
        raw: "Incapacitating rider injuries reported. " 
      },
      { 
        label: "Fatal", 
        value: "fatal", 
        output: '<span style="color: #a20000; font-weight: bold;">"Fatal rider injuries reported"</span>', 
        raw: "Fatal rider injuries reported. " 
      },
      { 
        label: "No driver injuries", 
        value: "no_driver_injuries", 
        output: '<span style="color: #ffc107; font-weight: bold;">"No driver injuries"</span>', 
        raw: "No driver injuries. " 
      }
    ]
  }),


<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ADV Incident Ingestion Wizard</title>
    <style>
        :root {
            --bg-main: #141419;
            --bg-panel: #22222a;
            --bg-card: #2e2e38;
            --text-main: #f0f0f5;
            --text-muted: #a0a0b0;
            --accent-mint: #00fa9a;
            --accent-blue: #00bfff;
            
            /* Visual Audit Theme Matrix Colors */
            --color-standard-green: #11734b;
            --color-uber-green: #166c3b;
            --color-light-green: #2e7d32;
            --color-yellow: #fbc02d;
            --color-orange: #f57c00;
            --color-light-pink: #d32f2f;
            --color-dark-red: #8b0000;
            --color-purple: #7b1fa2;
            --color-bright-blue: #1976d2;
            --color-dark-teal: #00796b;
            --color-brown-olive: #556b2f;
            --color-gold: #d4af37;
            --color-dark-gray: #555555;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            background-color: var(--bg-main);
            color: var(--text-main);
            margin: 0;
            padding: 30px 20px;
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        .container {
            width: 100%;
            max-width: 850px;
            display: flex;
            flex-direction: column;
            gap: 25px;
        }

        .panel {
            background-color: var(--bg-panel);
            border-radius: 12px;
            padding: 30px;
            box-shadow: 0 8px 24px rgba(0,0,0,0.4);
            border: 1px solid #333340;
        }

        h2 {
            margin-top: 0;
            font-size: 1.3rem;
            color: var(--text-main);
            border-bottom: 1px solid #3d3d4d;
            padding-bottom: 12px;
            margin-bottom: 20px;
        }

        label {
            display: block;
            font-weight: 600;
            margin-bottom: 8px;
            font-size: 1rem;
        }

        .wizard-nav {
            display: flex;
            justify-content: space-between;
            margin-top: 30px;
            border-top: 1px solid #3d3d4d;
            padding-top: 20px;
        }

        .btn {
            background-color: #3e3e4d;
            color: var(--text-main);
            border: none;
            padding: 12px 24px;
            border-radius: 6px;
            cursor: pointer;
            font-weight: bold;
            font-size: 1rem;
            transition: all 0.2s ease;
        }

        .btn:hover {
            background-color: #4e4e5d;
        }

        .btn-primary {
            background-color: var(--accent-blue);
            color: #141419;
        }

        .btn-primary:hover {
            background-color: #33ccff;
        }

        .btn-copy {
            background-color: #bcd4e6;
            color: #101820;
            font-weight: bold;
            width: 100%;
            padding: 16px;
            font-size: 1rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 15px;
            border-radius: 8px;
            border: none;
            cursor: pointer;
            transition: background-color 0.2s;
        }

        .btn-copy:hover {
            background-color: #a3c1ad;
        }

        .wizard-card {
            display: none;
            flex-direction: column;
            gap: 16px;
        }

        .wizard-card.active {
            display: flex;
        }
        
        /* Lines 138-142: Hide headers/labels to prevent operator distraction */
        .wizard-card h2, 
        .wizard-card label {
            display: none !important;
        }

        .options-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
            gap: 12px;
        }

        .option-btn {
            background-color: var(--bg-card);
            border: 2px solid transparent;
            padding: 16px;
            border-radius: 8px;
            cursor: pointer;
            text-align: center;
            color: var(--text-main);
            transition: all 0.15s ease;
            font-weight: 500;
            font-size: 0.95rem;
        }

        .option-btn:hover {
            background-color: #3d3d4d;
            border-color: var(--text-muted);
        }

        .option-btn.selected {
            border-color: var(--accent-mint);
            background-color: #243a32;
        }

        .input-text {
            width: 100%;
            padding: 14px;
            background-color: var(--bg-card);
            border: 1px solid #444455;
            border-radius: 6px;
            color: var(--text-main);
            font-size: 1rem;
            box-sizing: border-box;
        }

        .input-text:focus {
            outline: none;
            border-color: var(--accent-blue);
        }

        .spinner-container {
            display: flex;
            align-items: center;
            gap: 15px;
            background-color: var(--bg-card);
            padding: 10px 20px;
            border-radius: 8px;
            width: fit-content;
        }

        .spinner-btn {
            width: 40px;
            height: 40px;
            font-size: 1.5rem;
            background-color: #444455;
            color: var(--text-main);
            border: none;
            border-radius: 6px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .spinner-btn:hover {
            background-color: #555566;
        }

        .spinner-value {
            font-size: 1.4rem;
            font-weight: bold;
            width: 50px;
            text-align: center;
        }

        .car-wireframe-container {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 15px;
        }

        .car-svg {
            width: 240px;
            height: 380px;
        }

        .car-region {
            fill: #3e3e4d;
            stroke: #141419;
            stroke-width: 2;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .car-region:hover {
            fill: var(--accent-blue);
        }

        .car-region.selected {
            fill: var(--accent-mint);
        }

        .car-label {
            fill: var(--text-main);
            font-size: 12px;
            font-weight: bold;
            pointer-events: none;
            text-anchor: middle;
        }

        .preview-box {
            background-color: #4a4a4a;
            color: #ffffff;
            font-family: "Courier New", Courier, monospace;
            padding: 22px;
            border-radius: 8px;
            white-space: pre-wrap;
            line-height: 1.6;
            font-size: 0.95rem;
            border: 1px solid #5a5a5a;
        }

        .preview-clickable-fragment {
            cursor: pointer;
            border-bottom: 1px dashed transparent;
            padding: 1px 2px;
            border-radius: 3px;
            display: inline;
        }

        .preview-clickable-fragment:hover {
            background-color: rgba(255,255,255,0.2);
            border-bottom-color: #fff;
        }

        .override-panel {
            margin-top: 15px;
            padding-top: 15px;
            border-top: 1px dashed #444455;
            display: flex;
            justify-content: flex-end;
        }

        .hint-text {
            font-size: 0.85rem;
            color: var(--text-muted);
            margin-top: -4px;
            margin-bottom: 12px;
        }
    </style>
</head>
<body>
<div class="container">
    <div class="panel">
        <h2 id="card-title-header">Question Base</h2>
                <!-- Q0: Location Data -->
        <div class="wizard-card active" id="card-q0">
            <label for="input-location">Location String Input:</label>
            <div class="hint-text">Format Hint: 1080 west addison, chicago, il</div>
            <input type="text" id="input-location" class="input-text" placeholder="1080 west addison, chicago, il">
        </div>

        <!-- Q1: Rider Fleet Ingestion -->
        <div class="wizard-card" id="card-q1">
            <label>Was there a rider present in the vehicle?</label>
            <div class="options-grid" id="grid-q1"></div>
        </div>

        <!-- Q2: Mission Timeline Status -->
        <div class="wizard-card" id="card-q2">
            <label>When in the trip did this incident occur?</label>
            <div class="options-grid" id="grid-q2"></div>
        </div>

        <!-- Q3: Speed and Lane Parameters Matrix -->
        <div class="wizard-card" id="card-q3">
            <label>ADV Operating Speed:</label>
            <div class="spinner-container">
                <button class="spinner-btn" onclick="adjustSpeed(-1)">-</button>
                <div class="spinner-value" id="spinner-speed-val">0</div>
                <button class="spinner-btn" onclick="adjustSpeed(1)">+</button>
                <span>MPH</span>
            </div>
            
            <label style="margin-top:20px; display:block;">Lane Positioning Profile:</label>
            <div class="options-grid" id="grid-q3b"></div>

            <label style="margin-top:20px; display:block;">Direction / Activity Trajectory:</label>
            <div class="options-grid" id="grid-q3c"></div>
        </div>

        <!-- Q4a: External Catalyst Definition -->
        <div class="wizard-card" id="card-q4a">
            <label>What was the external trigger or third-party agent?</label>
            <div class="options-grid" id="grid-q4a"></div>
        </div>

        <!-- Q4b: Action Parameter Ingestion -->
        <div class="wizard-card" id="card-q4b">
            <label id="label-q4b">What did the agent do?</label>
            <input type="text" id="input-q4b" class="input-text" placeholder="e.g., cut off ADV suddenly">
        </div>

        <!-- Q5: ADV Trajectory Anomaly Manifest -->
        <div class="wizard-card" id="card-q5">
            <label>What did this cause the ADV to do?</label>
            <input type="text" id="input-q5" class="input-text" value="remain stationary">
        </div>

        <!-- Q6: Top-Down Visual Asset Damage Wireframe Component -->
        <div class="wizard-card" id="card-q6">
            <label>What was the immediate physical contact point?</label>
            <div class="car-wireframe-container">
                <div class="options-grid" style="width:100%; margin-bottom: 10px;">
                    <button class="option-btn selected" id="btn-wireframe-nocontact" onclick="setWireframeNoContact()">No Contact</button>
                    <button class="option-btn" id="btn-wireframe-interior" onclick="toggleWireframeRegion('interior')">Interior</button>
                </div>
                
                <svg class="car-svg" viewBox="0 0 200 340">
                    <rect x="50" y="30" width="100" height="280" rx="30" fill="#2d2d35" stroke="#555" stroke-width="3" />
                    <path id="wf-front" class="car-region" d="M 50 60 Q 100 20 150 60 L 150 90 L 50 90 Z" onclick="toggleWireframeRegion('front')" />
                    <path id="wf-left" class="car-region" d="M 50 90 L 80 90 L 80 250 L 50 250 Z" onclick="toggleWireframeRegion('left')" />
                    <path id="wf-right" class="car-region" d="M 120 90 L 150 90 L 150 250 L 120 250 Z" onclick="toggleWireframeRegion('right')" />
                    <path id="wf-window" class="car-region" d="M 80 110 L 120 110 L 120 170 L 80 170 Z" onclick="toggleWireframeRegion('window')" />
                    <path id="wf-top" class="car-region" d="M 80 170 L 120 170 L 120 230 L 80 230 Z" onclick="toggleWireframeRegion('top')" />
                    <path id="wf-back" class="car-region" d="M 50 250 L 150 250 L 150 280 Q 100 320 50 280 Z" onclick="toggleWireframeRegion('back')" />
                    <path id="wf-undercarriage" class="car-region" d="M 50 30 Q 100 0 150 30 L 150 50 L 50 50 Z" onclick="toggleWireframeRegion('undercarriage')" />

                    <text x="100" y="55" class="car-label">FRONT</text>
                    <text x="40" y="165" class="car-label" transform="rotate(-90 40 165)">LEFT SIDE</text>
                    <text x="160" y="165" class="car-label" transform="rotate(90 160 165)">RIGHT SIDE</text>
                    <text x="100" y="145" class="car-label">WINDOW</text>
                    <text x="100" y="295" class="car-label">BACK</text>
                    <text x="100" y="215" class="car-label" style="font-size:10px;">TOP</text>
                    <text x="100" y="28" class="car-label" style="font-size:8px;">UNDER</text>
                </svg>
            </div>
        </div>
        <!-- Q7: Post Incident ADV Recovery State -->
        <div class="wizard-card" id="card-q7">
            <label>What was the post-incident status of the ADV?</label>
            <div class="options-grid" id="grid-q7"></div>
        </div>

        <!-- Q8: Law Enforcement On-Scene Engagement Metric -->
        <div class="wizard-card" id="card-q8">
            <label>Did an agent or safety driver speak with Law Enforcement Officers (LEO) on the scene?</label>
            <div class="options-grid" id="grid-q8"></div>
        </div>

        <!-- Q9: 911 Trigger Manifest -->
        <div class="wizard-card" id="card-q9">
            <label>Was 911 called?</label>
            <div class="options-grid" id="grid-q9"></div>
        </div>

        <!-- Q9b: 911 Call Escalation Parameters Ingestion -->
        <div class="wizard-card" id="card-q9b">
            <label>Why was 911 called?</label>
            <input type="text" id="input-q9b" class="input-text" placeholder="e.g., medical assistance requested for external party">
        </div>

        <!-- Q10: ERT Maneuver Verification -->
        <div class="wizard-card" id="card-q10">
            <label>Did ERT suggest a maneuver to the ADV?</label>
            <div class="options-grid" id="grid-q10"></div>
        </div>

        <!-- Q11: Remote Safety Hold Assertion -->
        <div class="wizard-card" id="card-q11">
            <label>Was a remote or safety hold placed on the ADV following the incident?</label>
            <div class="options-grid" id="grid-q11"></div>
        </div>

        <!-- Q13: External Agent Post Incident Track Status -->
        <div class="wizard-card" id="card-q13">
            <label>What did the ORU or VRU do immediately following the interaction?</label>
            <div class="options-grid" id="grid-q13"></div>
        </div>

        <!-- Q12: Insurance Settlement Log -->
        <div class="wizard-card" id="card-q12">
            <label>Did ERT exchange insurance information with the Other Road User (ORU)?</label>
            <div class="options-grid" id="grid-q12"></div>
        </div>

        <!-- Q15: External Demographic Injury Profile Assessment -->
        <div class="wizard-card" id="card-q15">
            <label>What was the injury status of the Other Road User (ORU) or Vulnerable Road User (VRU)?</label>
            <div class="options-grid" id="grid-q15"></div>
        </div>

        <!-- Q14: Internal Demographic Asset Trauma Profiling -->
        <div class="wizard-card" id="card-q14">
            <label id="label-q14">What was the injury status of the rider?</label>
            <div class="options-grid" id="grid-q14"></div>
        </div>

        <!-- Q16: Passenger Self Preservation Requests Tracker -->
        <div class="wizard-card" id="card-q16">
            <label>What immediate actions did the rider request due to feeling unsafe? (Select all that apply)</label>
            <div class="options-grid" id="grid-q16"></div>
        </div>

        <!-- Q17: Mission Resolution Pipeline State -->
        <div class="wizard-card" id="card-q17">
            <label>How did the rider officially conclude their trip?</label>
            <div class="options-grid" id="grid-q17"></div>
        </div>

        <!-- Q18: Financial Compensation Model Manifest -->
        <div class="wizard-card" id="card-q18">
            <label>What specific promotions or compensation were applied to the rider's account?</label>
            <div class="options-grid" id="grid-q18"></div>
        </div>
        <!-- Q19: Asset Physical Resolution Manifest -->
        <div class="wizard-card" id="card-q19">
            <label>What was the physical resolution and destination for the ADV immediately after the event?</label>
            <div class="options-grid" id="grid-q19"></div>
        </div>

        <!-- Q20: Damage Categorization Matrix -->
        <div class="wizard-card" id="card-q20">
            <label>ADV Damage Classification:</label>
            <div class="options-grid" id="grid-q20"></div>
        </div>

        <!-- Q20b: Structural Damage Descriptive Details -->
        <div class="wizard-card" id="card-q20b">
            <label>State the damage details:</label>
            <input type="text" id="input-q20b" class="input-text" placeholder="e.g., minor scuff marks on the front lower bumper casing">
        </div>

        <!-- Q21: Regional Airport Jurisdiction Clearance Check -->
        <div class="wizard-card" id="card-q21">
            <label>Was AZ DPS/ Sky Harbor GTO called?</label>
            <div class="options-grid" id="grid-q21"></div>
        </div>

        <!-- Q23: ORU License Plate Tracking Parameters -->
        <div class="wizard-card" id="card-q23">
            <label style="font-weight:bold; margin-bottom:4px; display:block;">ORU LP STATE:</label>
            <select id="select-q23-state" class="input-text" onchange="handlePlateStateChange()">
                <option value="N/A">N/A</option>
                <option value="UNKNOWN">UNKNOWN</option>
                <option value="AZ">AZ</option>
                <option value="CA">CA</option>
                <option value="TX">TX</option>
                <option value="NV">NV</option>
                <option value="IL">IL</option>
            </select>
            
            <div id="wrapper-q23-plate" style="margin-top: 15px; display: none;">
                <label style="font-weight:bold; margin-bottom:4px; display:block;">ORU license plate:</label>
                <input type="text" id="input-q23-plate" class="input-text" style="text-transform: uppercase;" placeholder="GWBWRGB">
            </div>
        </div>

        <!-- Q24: Escalation Log Pipeline Integration Matrix -->
        <div class="wizard-card" id="card-q24">
            <label>Did you speak to the rider?</label>
            <div class="options-grid" id="grid-q24"></div>
            
            <div id="wrapper-q24-links" style="margin-top:15px; display:none; flex-direction:column; gap:12px;">
                <label>Call Link URL Reference:</label>
                <input type="text" id="input-q24-calllink" class="input-text" placeholder="https://google.com...">
                
                <label>Case Notes Link URL Reference:</label>
                <input type="text" id="input-q24-caseid" class="input-text" placeholder="https://force.com...">
            </div>

            <label style="margin-top:15px; display:block;">Were there any TOS violations?</label>
            <div class="options-grid" id="grid-q24c"></div>
        </div>

        <!-- Layout Footer Navigation Control Panel -->
        <div class="wizard-nav">
            <button class="btn" id="nav-btn-prev" onclick="navigateStep(-1)">Back</button>
            <button class="btn btn-primary" id="nav-btn-next" onclick="navigateStep(1)">Next</button>
        </div>

        <!-- Manual Contingency Routing Action Bar -->
        <div class="override-panel">
            <button class="btn" style="font-size: 0.75rem; padding: 4px 8px;" onclick="forceOpenCommunications()">🔓 Manually log call links / case notes</button>
        </div>
    </div>

    <!-- Active Text Rendering Output Frames -->
    <div class="panel">
        <button class="btn btn-copy" onclick="copyToClipboard('eri')">Copy My ERI To Clipboard</button>
        <div class="preview-box" id="preview-frame-eri">Preview data rendering...</div>
    </div>

    <div class="panel">
        <button class="btn btn-copy" style="background-color:#b0c4de;" onclick="copyToClipboard('call')">Copy My Call Template To Clipboard</button>
        <div class="preview-box" id="preview-frame-call">Preview data rendering...</div>
    </div>

</div>
<script>
        // System Index Routing Sequence Layout 
    const sequentialWorkflowSteps = [
        "q0", "q1", "q2", "q3", "q4a", "q4b", "q5", "q6", "q7", "q8", "q9", "q9b", "q10", "q11", "q13", "q12", "q15", "q14", "q16", "q17", "q18", "q19", "q20", "q20b", "q21", "q23", "q24"
    ];
    let currentWorkflowIndex = 0;
    let explicitCommOverrideActive = false;

    // Reactivity State Engine Ingestion Data Store
    const applicationState = {
        q0: "", q1: "1 rider", q2: "on trip",
        q3: { speed: 0, lane: "middle", action: "straight" },
        q4a: "Ped", q4b: "", q5: "remain stationary", q6: ["nocontact"],
        q7: "returned to normal", q8: "No", q9: "No", q9b: "", q10: "No", q11: "No",
        q13: "stayed on scene", q12: "N/A", q15: "none", q14: "none", q16: ["N/A"],
        q17: "no mission", q18: "none", q19: "returned to normal activity",
        q20: "zero damage", q20b: "", q21: "N/A",
        q23: { state: "N/A", plate: "" },
        q24: { spoke: "N/A", callLink: "", caseId: "", tos: "No" }
    };

    // Master Mapping Configuration Definitions (Text & Color Output Engine)
    const optionDefinitions = {
        q1: [
            { text: "1 rider", out: "There was a rider present", color: "#11734b" },
            { text: "riders", out: "There were riders present", color: "#11734b" },
            { text: "no riders", out: "There were no riders present", color: "#d32f2f" },
            { text: "driver", out: "There was a driver present", color: "#fbc02d" },
            { text: "uber rider", out: "There was an UBER rider present", color: "#166c3b" }
        ],
        q2: [
            { text: "on trip", out: ",on the rider's trip.", color: "#2e7d32" },
            { text: "pickup", out: ",at pickup.", color: "#1976d2" },
            { text: "dropoff", out: ",at dropoff.", color: "#f57c00" },
            { text: "driving freely", out: ",while the ADV was driving freely waiting for a mission.", color: "#d32f2f" },
            { text: "driver route", out: ",on driver's route.", color: "#fbc02d" }
        ],
        q3b: [
            { text: "middle", out: "in middle lanes,", color: "#00796b" },
            { text: "left lane", out: "in left lane,", color: "#2e7d32" },
            { text: "right lane", out: "in right lane,", color: "#7b1fa2" },
            { text: "parked curb", out: "in parked on curb position,", color: "#556b2f" },
            { text: "intersection", out: "in intersection,", color: "#d32f2f" },
            { text: "parking lot", out: "in parking lot,", color: "#555555" }
        ],
        q3c: [
            { text: "straight", out: "moving straight.", color: "#1976d2" },
            { text: "backwards", out: "moving backwards.", color: "#00796b" },
            { text: "turning right", out: "turning right.", color: "#7b1fa2" },
            { text: "merging right", out: "merging right.", color: "#555555" },
            { text: "turning left", out: "turning left.", color: "#556b2f" },
            { text: "merging left", out: "merging left.", color: "#556b2f" },
            { text: "stopping ped", out: "stopping for ped.", color: "#2e7d32" },
            { text: "stopping light", out: "stopping for traffic control.", color: "#1976d2" },
            { text: "slowing traffic", out: "slowing for traffic.", color: "#00796b" },
            { text: "stopping traffic", out: "stopping for traffic.", color: "#7b1fa2" },
            { text: "stopped", out: "stopped.", color: "#555555" },
            { text: "looping", out: "looping.", color: "#1976d2" }
        ],
        q4a: [
            { text: "Ped" }, { text: "More than one Ped" }, { text: "ORU" }, { text: "VRU" },
            { text: "LEO/FR" }, { text: "This ADV" }, { text: "Other ADV" }, { text: "an object" }
        ],
        q7: [
            { text: "returned to normal", out: "", color: "#2e7d32" },
            { text: "WRA dispatched", out: "Following the incident, WRA was dispatched.", color: "#fbc02d" },
            { text: "tow dispatched", out: "Following the incident, Tow was dispatched.", color: "#f57c00" },
            { text: "WRA & tow required", out: "Following the incident, WRA was dispatched and Tow was required.", color: "#d32f2f" }
        ],
        q8: [
            { text: "No", out: "", color: "#d32f2f" },
            { text: "Yes", out: "Spoke with LEO on scene.", color: "#2e7d32" },
            { text: "LEO present, no contact", out: "LEO Present on scene but no contact made.", color: "#f57c00" }
        ],
        q9: [
            { text: "No", out: "Emergency services were not called.", color: "#ffffff" },

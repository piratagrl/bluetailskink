    // Global Event Handler for Option Toggles and Dynamic Context Changes
    function selectOption(qId, val) {
        if (qId === "q16") {
            handleMultiCheckbox(qId, val);
            return;
        }

        applicationState[qId] = val;
        
        // Context Validation Side Effects Updates
        if (qId === "q1") {
            const lbl = document.getElementById("label-q14");
            if (val === "driver") {
                if (lbl) lbl.innerText = "What was the injury status of the driver?";
            } else {
                if (lbl) lbl.innerText = "What was the injury status of the rider?";
            }
            if (val === "no riders") {
                applicationState.q2 = "driving freely";
            }
        }
        if (qId === "q2" && val === "driving freely") {
            applicationState.q1 = "no riders";
        }
        if (qId === "q4a") {
            document.getElementById("label-q4b").innerText = `4b. What did the ${val === "an object" ? "object" : val} do?`;
        }
        if (qId === "q17" && val === "no mission") {
            applicationState.q18 = "none";
        }

        updateUIElements();
        compileAllTemplates();
    }

    function handleMultiCheckbox(qId, val) {
        let currentArr = applicationState[qId];
        if (val === "N/A") {
            currentArr = ["N/A"];
        } else {
            currentArr = currentArr.filter(x => x !== "N/A");
            if (currentArr.includes(val)) {
                currentArr = currentArr.filter(x => x !== val);
            } else {
                currentArr.push(val);
            }
            if (currentArr.length === 0) currentArr = ["N/A"];
        }
        applicationState[qId] = currentArr;
        updateUIElements();
        compileAllTemplates();
    }

    function adjustSpeed(amount) {
        let currentSpeed = applicationState.q3.speed;
        currentSpeed = Math.max(0, currentSpeed + amount);
        applicationState.q3.speed = currentSpeed;
        document.getElementById("spinner-speed-val").innerText = currentSpeed;
        compileAllTemplates();
    }

    function toggleWireframeRegion(region) {
        let activeRegions = applicationState.q6.filter(x => x !== "nocontact");
        if (activeRegions.includes(region)) {
            activeRegions = activeRegions.filter(x => x !== region);
        } else {
            activeRegions.push(region);
        }
        if (activeRegions.length === 0) activeRegions = ["nocontact"];
        applicationState.q6 = activeRegions;
        updateUIElements();
        compileAllTemplates();
    }

    function setWireframeNoContact() {
        applicationState.q6 = ["nocontact"];

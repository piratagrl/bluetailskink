            if (applicationState.q24.caseId.trim() !== "") tailLines.push(`*Case ID: ${applicationState.q24.caseId.trim()}`);
        }
        previewEriContainer.innerText += "\n" + tailLines.join("\n");
        // -------------------------
        // 3. THE CALL TEMPLATE DATA BLOCK
        // -------------------------
        let callLines = ["Summary of the event :", ""];
        callLines.push(`Was the trip waived? ${["trip waived", "waived & promo", "waived & gift card"].includes(applicationState.q18) ? "Yes" : "No"}`);
        callLines.push(`Was the trip canceled? ${applicationState.q17.startsWith("cancelled") ? "Yes" : "No"}`);
        callLines.push(`Were promo credits issued? ${["promo applied", "gift card issued", "waived & promo", "waived & gift card", "promo & gift card"].includes(applicationState.q18) ? "Yes" : "No"}`);
        callLines.push(`Was WRA recovery required? ${["WRA dispatched", "WRA & tow required"].includes(applicationState.q7) ? "Yes" : "No"}`);
        callLines.push(`Any identified rider violations? ${applicationState.q24.tos}`);
        callLines.push(`Was Supervisor Follow Up requested by rider? ${applicationState.q16.includes("follow up call") ? "Yes" : "No"}`);
        document.getElementById("preview-frame-call").innerText = callLines.join("\n");
    }

    // System Clipboard Engine integration
    function copyToClipboard(target) {
        const text = document.getElementById(target === 'eri' ? 'preview-frame-eri' : 'preview-frame-call').innerText;
        navigator.clipboard.writeText(text).then(() => alert(`Data Block Copied.`));
    }

    // Initialize System Core Run-Time Ingestions loops
    window.onload = () => {
        generateOptionGrids(); 
        showActiveCard(); 
        compileAllTemplates();
        document.querySelectorAll('.input-text').forEach(i => i.addEventListener('input', compileAllTemplates));
    };
</script>
</body>
</html>


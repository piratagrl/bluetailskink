    // Core Workflow Routing & Branch/Skip Rules Validator
    function checkStepShouldBeSkipped(qId) {
        const isNoRiderContext = (applicationState.q1 === "no riders");
        const isDriverContext = (applicationState.q1 === "driver");
        const isNoInvolvedParty = (applicationState.q13 === "no involved party");
        const agentSelection = applicationState.q4a;

        if (["q14", "q16", "q17", "q18"].includes(qId) && isNoRiderContext) return true;
        if (["q16", "q17", "q18"].includes(qId) && isDriverContext) return true;
        if (qId === "q12" && isNoInvolvedParty) return true;
        if (qId === "q15" && isNoInvolvedParty) return true;
        if (qId === "q9b" && applicationState.q9 !== "Yes") return true;
        if (qId === "q20b" && !["blocking", "non-blocking"].includes(applicationState.q20)) return true;
        
        if (qId === "q23") {
            if (agentSelection !== "ORU" && agentSelection !== "VRU") return true;
        }
        if (qId === "q24") {
            if (isNoRiderContext && !explicitCommOverrideActive) return true;
        }
        return false;
    }

    function navigateStep(direction) {
        let targetIndex = currentWorkflowIndex + direction;
        while (targetIndex >= 0 && targetIndex < sequentialWorkflowSteps.length) {
            const checkId = sequentialWorkflowSteps[targetIndex];
            if (!checkStepShouldBeSkipped(checkId)) {
                currentWorkflowIndex = targetIndex;
                break;
            }
            targetIndex += direction;
        }
        showActiveCard();
    }

    function jumpToStepSpecific(qId) {
        const idx = sequentialWorkflowSteps.indexOf(qId);
        if (idx !== -1) {
            currentWorkflowIndex = idx;
            showActiveCard();
        }
    }

    function showActiveCard() {
        const activeQId = sequentialWorkflowSteps[currentWorkflowIndex];
        
        // Hide all cards, show active card
        document.querySelectorAll(".wizard-card").forEach(c => c.classList.remove("active"));
        const currentTargetCard = document.getElementById(`card-${activeQId}`);
        if (currentTargetCard) currentTargetCard.classList.add("active");

        // Sync navigation button bounds
        document.getElementById("nav-btn-prev").style.visibility = (currentWorkflowIndex === 0) ? "hidden" : "visible";
        document.getElementById("nav-btn-next").innerText = (currentWorkflowIndex === sequentialWorkflowSteps.length - 1) ? "Finish" : "Next";

        updateUIElements();
    }

    function showActiveCard() {
        const activeQId = sequentialWorkflowSteps[currentWorkflowIndex];
        document.querySelectorAll(".wizard-card").forEach(c => c.classList.remove("active"));
        
        if (activeQId === "q23") {
            document.getElementById("card-title-header").innerText = "23. ORU license plate Tracking Parameters";
        } else {
            document.getElementById("card-title-header").innerText = cardTitleLookups[activeQId] || "Question Ingestion Engine";
        }
        
        const currentTargetCard = document.getElementById(`card-${activeQId}`);
        if (currentTargetCard) currentTargetCard.classList.add("active");

        document.getElementById("nav-btn-prev").style.visibility = (currentWorkflowIndex === 0) ? "hidden" : "visible";
        document.getElementById("nav-btn-next").innerText = (currentWorkflowIndex === sequentialWorkflowSteps.length - 1) ? "Finish" : "Next";

        updateUIElements();
    }
    // Sync active selection styles on the screen with database state
    function updateUIElements() {
        for (const [qId, val] of Object.entries(applicationState)) {
            const container = document.getElementById(`grid-${qId}`);
            if (!container) continue;

            if (Array.isArray(val)) {
                container.querySelectorAll(".option-btn").forEach(b => {
                    const bVal = b.getAttribute("data-val");
                    b.className = val.includes(bVal) ? "option-btn selected" : "option-btn";
                });
            } else {
                container.querySelectorAll(".option-btn").forEach(b => {
                    b.className = (b.getAttribute("data-val") === val) ? "option-btn selected" : "option-btn";
                });
            }
        }

        // Handle structural wireframe color mapping rules
        document.querySelectorAll(".car-region").forEach(reg => reg.classList.remove("selected"));
        document.getElementById("btn-wireframe-nocontact").className = "option-btn";
        document.getElementById("btn-wireframe-interior").className = "option-btn";

        if (applicationState.q6.includes("nocontact")) {
            document.getElementById("btn-wireframe-nocontact").className = "option-btn selected";
        } else {
            applicationState.q6.forEach(reg => {
                if (reg === "interior") {
                    document.getElementById("btn-wireframe-interior").className = "option-btn selected";
                } else {
                    const el = document.getElementById(`wf-${reg}`);
                    if (el) el.classList.add("selected");
                }
            });
        }

        document.getElementById("select-q23-state").value = applicationState.q23.state;
        document.getElementById("wrapper-q23-plate").style.display = (applicationState.q23.state === "N/A") ? "none" : "block";

        const spokeVal = applicationState.q24.spoke;
        document.getElementById("wrapper-q24-links").style.display = (spokeVal === "Yes") ? "flex" : "none";
    }

